# Copie para .env.local (nunca commitado) e preencha com as chaves do seu
# projeto Supabase (Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NUNCA prefixe com NEXT_PUBLIC_ — isso a exporia ao navegador. Ela só é lida
# em código server-only (src/lib/supabase/admin.ts, supabase/seed/*.mjs).
# É exatamente essa mistura (service_role usada onde deveria ser a chave da
# sessão do usuário) que o Laudo Técnico da Correa Tech encontrou em 7 dos
# 14 endpoints do COSMO/JACKBOY/Shema.AI. Aqui ela tem UM uso só: criar
# contas de professor a partir de uma ação já verificada como coordenação.
SUPABASE_SERVICE_ROLE_KEY=

# Chave da API da Anthropic (console.anthropic.com), usada SÓ em
# src/app/api/auxilio/route.ts — o back-end do Auxílio ao Professor. Também
# nunca prefixada com NEXT_PUBLIC_. Modelo e max_tokens ficam fixos no
# próprio route.ts (nunca aceitos do corpo da requisição do navegador) —
# mesma lição do Laudo Técnico citada acima, aplicada aqui à chave da IA em
# vez da do banco.
ANTHROPIC_API_KEY=
